"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star fill-amber-500 text-amber-500\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star fill-amber-500 text-amber-500\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg></div><p class=\"text-gray-700 leading-relaxed mb-6 text-sm italic\">&quot;<!-- -->The private jet experience was phenomenal. From the moment we stepped on the tarmac to our arrival, everything was orchestrated to absolute perfection. Worth every penny and more.<!-- -->&quot;</p><div class=\"border-t border-gray-200 pt-6 mb-4\"><div class=\"flex items-center gap-4\"><div class=\"relative w-12 h-12 rounded-full overflow-hidden flex-shrink-0\"><img alt=\"Carlos Mendez\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/reviewer-6.jpg\"/></div><div class=\"flex-1\"><p class=\"font-semibold text-gray-900 text-sm\">Carlos Mendez</p><p class=\"text-xs text-amber-600 font-medium\">Aerospace Engineer</p><p class=\"text-xs text-gray-500\">Miami, USA</p></div></div></div><p class=\"text-xs text-gray-400\">5 days ago</p></div></div></div></div></section><section class=\"py-20 px-6 bg-gray-50\"><div class=\"max-w-4xl mx-auto\"><div class=\"bg-white rounded-2xl shadow-lg p-10\"><h2 class=\"text-3xl font-serif font-bold text-gray-900 mb-4\">Share Your Experience</h2><p class=\"text-gray-600 mb-8\">Have you traveled with GARYPARROTBEACH? We&#x27;d love to hear about your journey.</p><form class=\"space-y-6\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block text-sm font-semibold text-gray-900 mb-2\">Your Name *</label><input type=\"text\" placeholder=\"John Doe\" required=\"\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-100\" name=\"name\" value=\"\"/></div><div><label class=\"block text-sm font-semibold text-gray-900 mb-2\">Title/Profession</label><input type=\"text\" placeholder=\"e.g., CEO, Entrepreneur\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-100\" name=\"title\" value=\"\"/></div></div><div><label class=\"block text-sm font-semibold text-gray-900 mb-2\">Email Address *</label><input type=\"email\" placeholder=\"your@email.com\" required=\"\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-100\" name=\"email\" value=\"\"/></div><div><label class=\"block text-sm font-semibold text-gray-900 mb-2\">Your Rating *</label><select name=\"rating\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-100\"><option value=\"5\" selected=\"\">5 Stars - Exceptional</option><option value=\"4\">4 Stars - Excellent</option><option value=\"3\">3 Stars - Good</option><option value=\"2\">2 Stars - Fair</option><option value=\"1\">1 Star - Poor</option></select></div><div><label class=\"block text-sm font-semibold text-gray-900 mb-2\">Your Review *</label><textarea name=\"review\" placeholder=\"Share your experience with GARYPARROTBEACH. What made your journey special?\" rows=\"6\" required=\"\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-100 resize-none\"></textarea></div><button type=\"submit\" class=\"w-full bg-amber-600 text-white py-4 rounded-lg font-bold hover:bg-amber-700 transition flex items-center justify-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-send\" aria-hidden=\"true\"><path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"></path><path d=\"m21.854 2.147-10.94 10.939\"></path></svg>Submit Your Review</button></form><p class=\"text-xs text-gray-500 mt-6 text-center\">By submitting, you agree to our review policies. All reviews are moderated and verified.</p></div></div></section><section class=\"py-16 px-6 bg-gradient-to-r from-amber-600 to-amber-700 text-white\"><div class=\"max-w-7xl mx-auto text-center\"><h2 class=\"text-3xl font-serif font-bold mb-8\">Why Our Clients Trust Us</h2><div class=\"grid grid-cols-1 md:grid-cols-4 gap-8\"><div><p class=\"text-4xl font-bold mb-2\">2000+</p><p class=\"text-amber-50\">Journeys Completed</p></div><div><p class=\"text-4xl font-bold mb-2\">100+</p><p class=\"text-amber-50\">Destinations Served</p></div><div><p class=\"text-4xl font-bold mb-2\">98%</p><p class=\"text-amber-50\">5-Star Rating</p></div><div><p class=\"text-4xl font-bold mb-2\">20+</p><p class=\"text-amber-50\">Years Experience</p></div></div></div